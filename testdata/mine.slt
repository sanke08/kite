# Hand-written tests for what kite supports in Phases 1-4.
#
# Deliberately narrow: literal expressions, CREATE TABLE, INSERT, SELECT *.
# Nothing here needs WHERE, ORDER BY, aggregates or joins, because kite will
# not have them for weeks and a file full of failures teaches nothing.

# ---- Phase 2: expressions, no FROM ----

query I nosort
SELECT 1
----
1

query I nosort
SELECT 1+2*3
----
7

# Precedence again, the other way round.
query I nosort
SELECT (1+2)*3
----
9

# Unary minus vs binary minus, the classic Pratt off-by-one.
query I nosort
SELECT -2+3
----
1

query I nosort
SELECT 2- -3
----
5

query T nosort
SELECT 'a' || 'b'
----
ab

# A doubled quote is one literal quote, not the end of the string.
query T nosort
SELECT 'it''s'
----
it's

# Comparison with NULL is NULL, never false. Three-valued logic.
query I nosort
SELECT 1 = NULL
----
NULL

query I nosort
SELECT 1 = 1
----
1

query R nosort
SELECT 2.5
----
2.500

# ---- Phase 3: CREATE TABLE ----

statement ok
CREATE TABLE t(a INTEGER, b TEXT)

statement error
CREATE TABLE t(a INTEGER)

statement error
SELECT * FROM nosuchtable

# ---- Phase 4: INSERT and SELECT * ----

statement ok
INSERT INTO t VALUES (1, 'one')

statement ok
INSERT INTO t VALUES (2, 'two')

statement ok
INSERT INTO t VALUES (3, 'three')

# Rows come back in insertion order.
query IT nosort
SELECT * FROM t
----
1
one
2
two
3
three

statement error
INSERT INTO nosuchtable VALUES (1)

# An empty table returns no rows, which is not an error.
statement ok
CREATE TABLE empty_table(x INTEGER)

query I nosort
SELECT * FROM empty_table
----

# NULL survives a round trip through storage.
statement ok
INSERT INTO t VALUES (4, NULL)

query IT nosort
SELECT * FROM t
----
1
one
2
two
3
three
4
NULL

# Three-valued logic. NULL means unknown, so it does not collapse to false.

query I nosort
SELECT NOT (1 = NULL)
----
NULL

query I nosort
SELECT 0 AND NULL
----
0

query I nosort
SELECT 1 AND NULL
----
NULL

query I nosort
SELECT 1 OR NULL
----
1

query I nosort
SELECT NULL IS NULL
----
1

query I nosort
SELECT 1 IS NOT NULL
----
1

# Left-associativity. 10-3-2 is (10-3)-2, not 10-(3-2).

query I nosort
SELECT 10-3-2
----
5

# Integer division truncates; one real operand makes the whole thing real.

query I nosort
SELECT 7/2
----
3

query R nosort
SELECT 7/2.0
----
3.500

# Division by zero is NULL in SQL, not an error.

query I nosort
SELECT 1/0
----
NULL

# Text coerces to a number by reading as far as it can.

query I nosort
SELECT '12abc'+1
----
13

query I nosort
SELECT 'abc'+1
----
1

# NULL propagates through arithmetic and concatenation.

query I nosort
SELECT NULL+1
----
NULL

query T nosort
SELECT NULL || 'x'
----
NULL

# ---- Phase 3: CREATE TABLE and the catalog ----

statement ok
CREATE TABLE phase3(a INTEGER, b VARCHAR(255), c)

statement error
CREATE TABLE phase3(a INTEGER)

statement ok
DROP TABLE phase3

statement error
DROP TABLE phase3

# A column may have no declared type at all.
statement ok
CREATE TABLE untyped(x)

statement ok
DROP TABLE untyped

# Multi-word types parse as one type.
statement ok
CREATE TABLE widetypes(a DOUBLE PRECISION, b DECIMAL(10,5), c UNSIGNED BIG INT)

statement ok
DROP TABLE widetypes
